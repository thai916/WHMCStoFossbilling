{% extends "layout_default.html.twig" %}
{% set active_menu = 'extensions' %}
{% block meta_title %}WHMCStoFossbilling{% endblock %}
{% block head %}
<link rel="stylesheet" href="{{ migrator_css }}">
<script src="{{ migrator_js }}" defer></script>
{% endblock %}
{% block content %}
<div id="whmcstofossbilling" data-api="{{ migrator_api }}" data-csrf="{{ migrator_csrf }}">
    <div class="wm-heading">
        <div class="wm-brand"><img src="{{ migrator_icon }}" class="wm-logo" width="56" height="56" alt=""><div><div class="text-muted small">WHMCS 8.x → FOSSBilling 0.8.9</div><h2>WHMCStoFossbilling <span class="badge bg-orange-lt">0.2 · experimental</span></h2><p>Read-only at the source. Traceable at the destination.</p></div></div>
        <div class="wm-seal"><strong>SELECT ONLY</strong><span>Production source protection</span></div>
    </div>
    <div class="alert alert-warning">
            <strong>Preserve history first. Publish supported records safely.</strong> This is not a complete billing migration. This experimental tool is not ready for a live billing cutover.
            <details class="mt-2"><summary>Supported records and migration limits</summary><p>Native clients, catalog, closed tickets and email history are supported. Historical mode also supports eligible inactive hosting, representable historical invoices, payments and verified credit aggregates. Active services, domains, unpaid invoices and unsupported financial cases remain blocked natively; eligible source records stay in the private legacy archive. Attachments require a separate file transfer.</p><ul id="wm-blockers" class="mt-2"></ul></details>
    </div>
    <div id="wm-notice" class="alert d-none" role="status" aria-live="polite"></div>
    <div id="wm-schema-warning" class="alert alert-warning d-none">This preview needs additional extension-owned tracking tables. No schema change runs automatically. <button class="btn btn-warning" id="wm-schema-upgrade" type="button">Upgrade extension tables only</button></div>
    <nav class="wm-steps mb-3" aria-label="Migration steps">
        <button type="button" class="btn btn-primary" data-step="connection">1 · Connect</button>
        <button type="button" class="btn btn-outline-secondary" data-step="mapping" disabled>2 · Map fields</button>
        <button type="button" class="btn btn-outline-secondary" data-step="analysis" disabled>3 · Review & preview</button>
        <button type="button" class="btn btn-outline-secondary" data-step="progress">4 · Runs & reports</button>
        <button type="button" class="btn btn-outline-secondary" data-step="archive">Legacy archive</button>
    </nav>
    <div id="wm-top-progress" class="wm-top-progress d-none mb-3">
        <div class="d-flex justify-content-between gap-2 small mb-1"><span id="wm-progress-label" aria-live="polite">No active run</span><strong id="wm-progress-percent">0%</strong></div>
        <div class="progress" role="progressbar" aria-valuemin="0" aria-valuemax="100" aria-valuenow="0" aria-valuetext="0%" aria-labelledby="wm-progress-label"><div id="wm-progress-bar" class="progress-bar" style="width:0%"></div></div>
    </div>
    <section data-panel="connection" class="card">
        <div class="card-header"><h3 class="card-title">WHMCS database connection</h3></div>
        <div class="card-body">
            <div class="alert alert-info">
                <strong>Important: Remote Database Access</strong>
                <p class="mb-1">Before connecting to your live WHMCS database, add the current public IP address of the FOSSBilling server to the Remote MySQL/Remote Database Access allowlist on the WHMCS hosting server.</p>
                <p class="mb-1">Use a dedicated database account with SELECT-only permissions. The migration tool will read data from WHMCS but will never modify the WHMCS database.</p>
                <p class="mb-2">Look up this FOSSBilling server’s public outbound IPv4 address, not the browser’s LAN address. This sends an HTTPS request to api.ipify.org, which will see the server’s public IP. No database credentials or customer data are sent.</p>
                <div class="d-flex gap-2 align-items-center flex-wrap"><button type="button" id="wm-ip-lookup" class="btn btn-outline-primary">Show public IP</button><output id="wm-public-ip" class="wm-ip-address" aria-live="polite">Not checked</output><button type="button" id="wm-ip-copy" class="btn btn-outline-secondary" disabled>Copy IP</button></div>
                <p id="wm-ip-status" class="small mt-2 mb-0">No automatic lookup. VPNs, proxies and routing can change the IP your MySQL server sees; verify it with your hosting provider.</p>
            </div>
            <form id="wm-connection">
                <div class="row g-3">
                    <div class="col-md-8"><label class="form-label" for="wm-host">Database hostname / IP</label><input id="wm-host" class="form-control" name="host" required maxlength="253" autocomplete="off" placeholder="db.example.com"></div>
                    <div class="col-md-4"><label class="form-label" for="wm-port">Port</label><input id="wm-port" class="form-control" name="port" type="number" min="1" max="65535" value="3306" required></div>
                    <div class="col-md-6"><label class="form-label" for="wm-database">Database name</label><input id="wm-database" class="form-control" name="database" required autocomplete="off"></div>
                    <div class="col-md-6"><label class="form-label" for="wm-username">SELECT-only username</label><input id="wm-username" class="form-control" name="username" required autocomplete="off"></div>
                    <div class="col-md-6"><label class="form-label" for="wm-password">Database password</label><input id="wm-password" class="form-control" name="password" type="password" autocomplete="new-password"></div>
                    <div class="col-md-3"><label class="form-label" for="wm-prefix">Table prefix</label><input id="wm-prefix" class="form-control" name="prefix" value="tbl" required></div>
                    <div class="col-md-3"><label class="form-label" for="wm-timeout">Connect timeout (seconds)</label><input id="wm-timeout" class="form-control" name="timeout" type="number" min="1" max="10" value="5"></div>
                    <div class="col-12"><label class="form-label" for="wm-security-mode">Connection security</label><select id="wm-security-mode" class="form-select" name="security_mode"><option value="standard" selected>Standard MySQL Connection (No TLS) (default)</option><option value="verified_tls">Verified TLS</option><option value="unverified_tls">TLS Without Certificate Verification (Advanced)</option></select><small>This affects only the remote WHMCS source connection. Secure failures never trigger a weaker retry.</small></div>
                    <div id="wm-security-risk" class="col-12 d-none"><div class="alert alert-warning mb-2" id="wm-security-warning" role="alert"></div><label class="form-check"><input id="wm-security-acknowledged" class="form-check-input" type="checkbox" name="security_acknowledged" value="1"><span class="form-check-label">I explicitly authorize this security mode for the WHMCS source and accept the warning above.</span></label></div>
                    <div class="col-12" id="wm-tls-settings"><label class="form-label" for="wm-ca">CA certificate path on the FOSSBilling server (optional override)</label><input id="wm-ca" class="form-control" name="tls_ca" value="{{ migrator_ca }}" autocomplete="off" aria-describedby="wm-ca-help"><small id="wm-ca-help">A readable default is selected automatically. Clear this field to reuse the default. Private/self-signed database certificates require your hosting provider’s CA. Use the hostname or IP named in the certificate. These fields do not apply to standard MySQL or unverified TLS.</small></div>
                    <div class="col-md-6"><label class="form-label" for="wm-version">WHMCS version</label><select id="wm-version" class="form-select" name="confirm_whmcs8" aria-describedby="wm-version-help"><option value="" selected>Auto-detect (recommended)</option><option value="WHMCS 8.x">WHMCS 8.x — I verified this manually</option></select><small id="wm-version-help">Only WHMCS 8.x is supported. The manual selection is used only when detection is unavailable; it never overrides an incompatible detected version.</small></div>
                    <div class="col-md-6"><label class="form-label" for="wm-timezone">WHMCS server timezone</label><select id="wm-timezone" class="form-select" name="source_timezone" required aria-describedby="wm-timezone-help"><option value="">Select the WHMCS application timezone</option>{% for timezone in migrator_timezones %}<option value="{{ timezone }}"{% if timezone == 'America/Chicago' %} selected{% endif %}>{{ timezone }}</option>{% endfor %}</select><input type="hidden" name="source_timezone_verified" value="1"><small id="wm-timezone-help">Set this to the timezone configured in WHMCS/PHP. It defaults to America/Chicago; MySQL offsets are not inspected or inferred. Date-only fields are never shifted.</small></div>
                </div>
                <div class="mt-3 d-flex gap-2 flex-wrap"><button class="btn btn-primary" id="wm-test-connection" type="submit"><span id="wm-connection-loader" class="wm-spinner d-none" aria-hidden="true"></span><span id="wm-connection-button-label">Test connection</span></button><button class="btn btn-outline-primary" id="wm-next" type="button" disabled>Next: Review field mapping</button></div>
            </form>
            <div id="wm-source-status" class="mt-3"></div>
            <div class="mt-3"><label class="form-label" for="wm-sources">Previously tested sources</label><select class="form-select" id="wm-sources"><option value="">Select a source…</option></select></div>
        </div>
    </section>
    <section data-panel="mapping" class="card d-none">
        <div class="card-header"><h3 class="card-title">Field compatibility & preservation</h3></div>
        <div class="card-body">
            <p>Every column has a disposition. Sensitive fields cannot be extracted. Only reviewed client text fields support editable native targets; relationship, date and monetary adapters are fixed, or archive-only. No confidential sample values are fetched.</p>
            <div class="d-flex gap-2 flex-wrap mb-3">
                <input class="form-control wm-search" id="wm-field-search" placeholder="Search table, field or target" aria-label="Search fields">
                <select class="form-select wm-search" id="wm-field-filter" aria-label="Filter mappings"><option value="">All mappings</option><option value="archive">Archive only</option><option value="native_and_archive">Native & archive</option><option value="exclude_sensitive">Excluded secrets</option><option value="skip">Intentional skips</option></select>
                <button class="btn btn-outline-secondary" id="wm-defaults" type="button">Restore recommended defaults</button>
                <button class="btn btn-outline-secondary" id="wm-profile-export" type="button">Export profile</button>
                <label class="btn btn-outline-secondary mb-0">Import profile<input id="wm-profile-import" type="file" accept=".json,application/json" hidden></label>
                <button class="btn btn-primary" id="wm-mapping-save" type="button">Validate & save mappings</button>
            </div>
            <div id="wm-fields"></div>
            <button class="btn btn-primary mt-3" id="wm-review" type="button">Next: Pre-migration analysis</button>
        </div>
    </section>
    <section data-panel="analysis" class="card d-none">
        <div class="card-header"><h3 class="card-title">Review & preview</h3><span class="wm-section-caption">Preserve first · review before writing</span></div>
        <div class="card-body">
            <div class="wm-review-intro">
                <div><h4>Choose how to preserve history</h4><p>Eligible tables start selected. Native modes also include required dependencies. Records without a safe native path remain in the private archive when extraction is supported.</p></div>
                <div><label class="form-label" for="wm-mode">What should this run do?</label><select class="form-select" form="wm-authorize" name="mode" id="wm-mode" aria-describedby="wm-mode-description wm-mode-limits"><option value="historical_native" selected>Import the most supported client history (default)</option><option value="reference_native">Import clients and support history</option><option value="archive">Save history in the private archive only</option></select></div>
            </div>
            <div class="wm-mode-explanation"><p id="wm-mode-description" aria-live="polite">Creates supported clients and history, including eligible inactive hosting and historical financial records. Other supported selected records stay in the private archive.</p><p id="wm-mode-limits">All modes preserve supported selected data in the administrator-only archive when resumed. Secrets are excluded or redacted. Attachments and unsupported records need separate work; not all history becomes visible in the client portal.</p><p id="wm-historical-mode-note">This mode requires a verified WHMCS timezone, a UTC-configured destination and an idle, private FOSSBilling installation for historical financial publication. No automation settings will be changed.</p></div>
            <div class="wm-table-toolbar">
                <label class="wm-table-search"><span class="form-label">Find a source table</span><input id="wm-table-search" class="form-control" type="search" placeholder="Search table names or status…"></label>
                <div id="wm-selection-summary" role="status" class="wm-selection-summary"></div>
            </div>
            <div id="wm-tables" class="wm-table-grid"></div>
            <p id="wm-table-empty" class="text-muted d-none">No matching tables. Clear the search to see all tables; your selection has not changed.</p>
            <div class="wm-analysis-actions"><div class="d-flex gap-2 flex-wrap"><button class="btn btn-outline-primary" id="wm-analyze" type="button">Analyze selected tables</button><button class="btn btn-primary" id="wm-dry-run" type="button">Create dry run</button></div><p>Read-only counts refresh automatically when needed, one table per request. A dry run does not save client history or create native records.</p></div>
            <form id="wm-authorize">
                <div class="wm-authorization-heading"><h4>Authorize migration</h4><p>Writes to FOSSBilling only. The new run starts paused; review it before resuming.</p></div>
                <label class="form-label mt-3" for="wm-backup">Verified destination backup reference (no secrets)</label><input class="form-control" name="backup_reference" id="wm-backup" maxlength="255" required>
                <label class="form-check mt-3"><input class="form-check-input" name="backup_verified" type="checkbox" value="1" required><span class="form-check-label">I verified that my destination database backup can be restored.</span></label>
                <label class="form-check mt-2"><input class="form-check-input" name="accept_limitations" type="checkbox" value="1" required><span class="form-check-label">I understand 0.2 is incomplete. Active hosting/domain orders and unsafe financial records remain blocked. Independent currency prices and gateway fees may be archive-only. Archives contain private data and recognized secrets are redacted.</span></label>
                <label class="form-check mt-2"><input class="form-check-input" id="wm-invalid-date-fallback" name="invalid_date_fallback" type="checkbox" value="1900"><span class="form-check-label">For invalid client registration dates, import 1900-01-01 00:00:00 natively. The exact original value stays in the archive and is listed in the run report.</span></label>
                <label class="form-check mt-2"><input class="form-check-input" name="destination_exclusive" type="checkbox" value="1"><span class="form-check-label">For “Import the most supported client history”: this FOSSBilling installation is private and no other administrator, customer or integration will create/change business records during this run. No global automation setting will be changed by this extension.</span></label>
                <label class="form-label mt-3" for="wm-confirm">Type PRESERVE HISTORY to authorize destination writes</label><input id="wm-confirm" class="form-control" name="confirmation" required autocomplete="off">
                <button class="btn btn-warning mt-3" type="submit">Create authorized run (starts paused)</button>
            </form>
        </div>
    </section>
    <section data-panel="progress" class="card d-none">
        <div class="card-header"><h3 class="card-title">Migration runs</h3></div>
        <div class="card-body">
            <label class="form-label" for="wm-runs">Select a run</label><select class="form-select" id="wm-runs"><option value="">Select a run…</option></select>
            <div id="wm-run-summary" class="mt-3"></div>
            <progress class="wm-progress" id="wm-progress" max="100" value="0" aria-label="Records scanned"></progress>
            <div class="d-flex gap-2 flex-wrap my-3">
                <button class="btn btn-primary" id="wm-resume" type="button">Resume processing</button>
                <button class="btn btn-outline-secondary" id="wm-pause" type="button">Pause</button>
                <button class="btn btn-outline-danger" id="wm-cancel" type="button">Cancel future batches</button>
                <button class="btn btn-outline-secondary" id="wm-refresh" type="button">Refresh status</button>
                <button class="btn btn-outline-warning" id="wm-retry" type="button">Retry up to 5 failed records</button>
                <button class="btn btn-outline-secondary" id="wm-report-json" type="button">Export JSON report</button>
                <button class="btn btn-outline-secondary" id="wm-report-csv" type="button">Export CSV report</button>
            </div>
            <p class="text-muted">Closing this tab stops future requests, not committed work. Reopen, select the run and resume. A cancelled run keeps imported records. There is no destructive automatic rollback.</p>
            <div class="wm-preservation-summary" aria-label="Preservation outcomes"><div><span>Native imported</span><strong id="wm-native-total">0</strong><small>Available through supported FOSSBilling features</small></div><div><span>Archive only</span><strong id="wm-archive-total">0</strong><small>Preserved as private legacy evidence</small></div><div><span>Needs attention</span><strong id="wm-failed-total">0</strong><small>Review exceptions; preservation may be incomplete</small></div></div>
            <div id="wm-counts"></div><h4 class="mt-3">Date substitutions (first 100)</h4><div id="wm-date-fallbacks"></div>
            <h4 class="mt-3">Exceptions (first 100)</h4><div id="wm-errors"></div>
            <h4 class="mt-3">Financial snapshot assessment</h4><div id="wm-financial"></div>
            <h4 class="mt-3">Client credit publication</h4><div id="wm-credit-results"></div>
        </div>
    </section>
    <section data-panel="archive" class="card d-none">
        <div class="card-header"><h3 class="card-title">Private legacy archive</h3></div>
        <div class="card-body">
            <p>Administrator-only historical evidence. Internal notes stay private; imported HTML is displayed as text. Files referenced by attachment fields have not been transferred.</p>
            <form id="wm-archive-search" class="d-flex gap-2 flex-wrap"><input class="form-control wm-search" name="table_name" placeholder="Exact source table (optional)" aria-label="Source table"><input class="form-control wm-search" name="source_key" placeholder="WHMCS record ID (optional)" aria-label="WHMCS ID"><select class="form-select wm-search" name="legacy_kind" aria-label="Legacy reference kind"><option value="invoice">Invoice number</option><option value="ticket">Ticket reference</option></select><input class="form-control wm-search" name="legacy_reference" placeholder="Exact legacy number/reference (optional)" aria-label="Legacy reference"><button class="btn btn-primary" type="submit">Search selected source</button></form>
            <div id="wm-archive-results" class="mt-3"></div>
        </div>
    </section>
    <p class="text-muted small mt-3">Author: Monlam Makhampa · This extension is vibe coded. Independent review and disposable-database testing are required before production use.</p>
</div>
{% endblock %}
